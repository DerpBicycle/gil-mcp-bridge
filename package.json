{
  "name": "gil-mcp-bridge",
  "version": "0.2.0",
  "description": "Stdio bridge for the Game Industry Library MCP server. Exposes the remote /api/mcp endpoint to MCP clients that only speak stdio (older Claude Desktop, Cline, etc.). Distributed via GitHub: install with `npx github:DerpBicycle/gil-mcp-bridge`.",
  "license": "MIT",
  "author": "Eric Diepeveen <mail@ericdiepeveen.com>",
  "homepage": "https://gameindustrylibrary.com/help/mcp-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/DerpBicycle/gil-mcp-bridge.git"
  },
  "type": "module",
  "bin": {
    "gil-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "login": "node dist/index.js login"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "chatgpt",
    "game-industry",
    "stdio-bridge"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
